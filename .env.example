# Public URL of your server (no trailing slash). Must be https in production.
GHOST_BASE_URL=https://ghost.example.com
# Set to 1 when running behind Render / Railway / Cloudflare (reverse proxy)
GHOST_TRUST_PROXY=1
# Secret ntfy topic for iPhone push notifications. Make it long and random.
NTFY_TOPIC=ghost-change-this-to-something-random-8f3k2
# Push a notification on every visitor tap (0/1)
GHOST_NOTIFY_TAPS=0
# How long a paired phone stays trusted (days) and how long a pairing link works (minutes)
GHOST_DEVICE_DAYS=365
GHOST_PAIR_MINUTES=10
